# -----------------------------
# 轻量日志（同时保存到文件）
# -----------------------------
class Monitor:
    def __init__(self, name="diag", save_dir=None):
        self.name = name
        self.items = []
        self.save_dir = save_dir
    def _push(self, level, msg):
        self.items.append((level, str(msg)))
    def info(self, msg): self._push("INFO", msg)
    def warn(self, msg): self._push("WARN", msg)
    def fail(self, msg): self._push("FAIL", msg)
    def header(self, title): self.info("="*8 + " " + title + " " + "="*8)
    def dump(self, fname=None):
        if self.save_dir:
            os.makedirs(self.save_dir, exist_ok=True)
            fn = fname or f"{self.name}.txt"
            path = os.path.join(self.save_dir, fn)
            with open(path, "w", encoding="utf-8") as f:
                for lvl, msg in self.items:
                    f.write(f"[{lvl}] {msg}\n")
            return path
        return None
    def dump_extra(self, path):
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "a", encoding="utf-8") as f:
                for lvl, msg in self.items:
                    f.write(f"[lvl={lvl}] {msg}\n")
        except Exception as e:
            self.warn(f"写入额外日志失败：{e}")

