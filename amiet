@dataclass
class FlowCondition:
    M: float
    rho: float
    mu: float
    U_inf: float
    a: Optional[float] = None
    Uc_factor: float = 0.75
    def __post_init__(self):
        if self.a is None:
            if self.M <= 0:
                raise ValueError("M must be > 0 to infer sound speed a")
            self.a = self.U_inf / self.M
    @property
    def nu(self) -> float:
        return self.mu / max(self.rho, 1e-12)

@dataclass
class AirfoilGeometry:
    chord: float
    span: float

@dataclass
class Observer:
    R: float
    theta: float
    phi: float

@dataclass
class BLParams:
    Ue: float
    Cf: float
    theta: float
    delta_star: float
    delta: float
    utau: Optional[float] = None
    Uc: Optional[float] = None
    APG_pi: Optional[float] = None
    def __post_init__(self):
        if self.utau is None:
            self.utau = self.Ue * np.sqrt(max(self.Cf, 1e-12)/2.0)
        if self.Uc is None:
            self.Uc = 0.75 * self.Ue

