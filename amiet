def _req_files_list(xc: float=0.98) -> Dict[str, str]:
    # 这里只给人看的 pattern，逻辑检查不再依赖字符串拼接
    return {
        "freestream": "freestream.csv",
        "profile_any": "line_normal_xc*_SS/PS/SUM.csv",
        "bl_params": "bl_params_TE.csv",
        "cf_curve":  "Cf_surface_xc.csv",
    }

def check_amiet_inputs_ready(amiet_dir: str, xc: float=0.98) -> Tuple[bool, List[str], Dict[str, str]]:
    req = _req_files_list(xc)
    missing: List[str] = []
    present: Dict[str,str] = {}

    # freestream（必须）
    f_fs = os.path.join(amiet_dir, "freestream.csv")
    has_fs = os.path.isfile(f_fs)
    if has_fs:
        present["freestream"] = f_fs
    else:
        missing.append(req["freestream"])

    # profile_any（必须）：只要目录里有任意 line_normal_xc*_SS/PS/SUM.csv 即认为存在
    prof_files = [f for f in os.listdir(amiet_dir)
                  if f.lower().startswith("line_normal_xc") and f.lower().endswith(".csv")]
    prof_any = None
    for fn in prof_files:
        if _parse_xc_from_profile_name(fn) is not None:
            prof_any = os.path.join(amiet_dir, fn)
            break
    has_prof = prof_any is not None
    if has_prof:
        present["profile_any"] = prof_any
    else:
        missing.append(req["profile_any"])

    # 其余文件视为“可选但推荐”
    f_bl = os.path.join(amiet_dir, "bl_params_TE.csv")
    if os.path.isfile(f_bl):
        present["bl_params"] = f_bl
    else:
        missing.append(req["bl_params"])
    f_cf = os.path.join(amiet_dir, "Cf_surface_xc.csv")
    if os.path.isfile(f_cf):
        present["cf_curve"] = f_cf
    else:
        missing.append(req["cf_curve"])

    ok = has_fs and has_prof
    return ok, missing, present

def ensure_amiet_inputs(case_dir: str, *, xc: float, mon: Monitor) -> str:
    amiet_dir = os.path.join(case_dir, "amiet_inputs")
    ok, miss, present = check_amiet_inputs_ready(amiet_dir, xc=xc)
    mon.header(f"Check amiet_inputs @ {amiet_dir}")
    if ok:
        mon.info(f"已就绪，发现：{present}")
        return amiet_dir
    mon.warn(f"不完整，缺：{miss}；尝试使用 of_probes_to_amiet 自动生成…")
    try:
        from of_probes_to_amiet import build_te_normal_profiles_all
        try:
            build_te_normal_profiles_all(case_dir)
        except TypeError:
            build_te_normal_profiles_all(str(case_dir))
    except Exception as e:
        mon.warn(f"调用 of_probes_to_amiet 失败：{e}")
    ok2, miss2, present2 = check_amiet_inputs_ready(amiet_dir, xc=xc)
    if ok2:
        mon.info(f"of_probes_to_amiet 生成成功：{present2}")
        return amiet_dir
    mon.warn(f"仍缺：{miss2}；进入分项补齐（从 case 既有文件重建）")
    try:
        rebuilt = rebuild_line_normal_from_probes(case_dir, amiet_dir, xc=xc, mon=mon)
        if rebuilt:
            mon.info(f"line_normal_xc 重建完成：{rebuilt}")
    except Exception as e:
        mon.warn(f"由 probes 重建 line-normal 失败：{e}")
    try:
        out_cf = rebuild_cf_and_bl_from_surface(case_dir, amiet_dir, mon=mon)
        if out_cf:
            mon.info(f"表面量派生完成：{out_cf}")
    except Exception as e:
        mon.warn(f"由 surfaces/raw 补齐 Cf/BL 失败：{e}")
    ok3, miss3, present3 = check_amiet_inputs_ready(amiet_dir, xc=xc)
    if ok3:
        mon.info(f"分项补齐成功：{present3}")
        return amiet_dir
    raise RuntimeError(f"amiet_inputs 仍不完整：缺 {miss3}。请检查 probes / surfaces 输出是否存在。")

