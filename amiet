# 可选 Nguyen2018 路线（保持）
# =============================
def _tno_nguyen2018_route(f: np.ndarray, y: np.ndarray, U: np.ndarray,
                          flow: FlowCondition, geo: AirfoilGeometry, obs: Observer,
                          bl: BLParams, side: str="SS", mon: Optional[Monitor]=None) -> np.ndarray:
    if mon: mon.header("Nguyen2018 route")
    rho = flow.rho
    Ue = bl.Ue; delta = max(bl.delta, 1e-12)
    nu = flow.nu
    dUdy = np.gradient(U, y, edge_order=2)
    kappa = 0.41
    yp = np.maximum(y*bl.utau/max(nu,1e-12), 0.0)
    l_in = kappa*y*(1.0 - np.exp(-yp/26.0))
    nut_in = (l_in**2)*np.abs(dUdy)
    nut_out = 0.0168*Ue*max(bl.delta_star, 1e-12)/(1.0 + 5.5*(np.clip(y/delta,0,50)**6))
    use_outer = nut_out > nut_in
    nut = np.where(use_outer, nut_out, l_in**2*np.abs(dUdy))
    l = np.where(use_outer, np.maximum(l_in, 1e-9), l_in)
    L2 = np.maximum(l/np.maximum(kappa, 1e-12), 1e-12)
    a_k = 2.0
    k_tke = a_k * (np.maximum(nut/L2, 0.0)**2)
    alpha_k = 0.4 if side.upper()=="SS" else 0.25
    u2sq = alpha_k * k_tke
    ke = 0.7/np.maximum(2.0*L2, 1e-12)
    Uc = max(0.7*flow.U_inf, 1e-12)
    two_pi = 2.0*np.pi
    f = np.asarray(f, float); omega = two_pi*f
    k1 = omega/Uc
    kabs = np.abs(k1)
    beta1, beta3 = 1.0, 0.75
    def phi22(k1s, kes):
        r1 = (beta1 * k1s / np.maximum(kes, 1e-16))**2
        return (4.0/(9.0*np.pi))*(beta1*beta3)*(kes**2) * (r1) / np.maximum((1.0 + r1)**(7.0/3.0), 1e-30)
    PhiP = np.zeros_like(f, dtype=float)
    base = 4.0*(rho**2)
    for i in range(f.size):
        phi22_y = phi22(k1[i], ke)
        integrand = L2 * np.abs(dUdy) * np.maximum(u2sq, 0.0) * phi22_y * np.exp(-2.0*kabs[i]*y)
        PhiP[i] = base * np.trapz(integrand, y)
    ke_cut = np.maximum(np.mean(ke), 1e-16)
    H = 1.0 / (1.0 + (kabs/ke_cut)**2)
    PhiP *= H
    Spp = amiet_compact_te_Spp(f, PhiP, flow, geo, obs, mon)
    Spp = np.minimum(Spp, (1e4)*(20e-6)**2)
    return Spp

