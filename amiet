def _dump_input_snapshot(path_dir, *, flow, bl, geo, chosen_side, sources):
    """把关键输入写到 JSON，便于复现（轻量、失败静默）。"""
    try:
        snap = dict(
            side=str(chosen_side),
            sources=sources,
            flow=dict(M=getattr(flow,'M',None), a=getattr(flow,'a',None),
                      U_inf=getattr(flow,'U_inf',None), rho=getattr(flow,'rho',None),
                      mu=getattr(flow,'mu',None)),
            bl=dict(Ue=bl.Ue, Cf=bl.Cf, theta=bl.theta, delta_star=bl.delta_star,
                    delta99=getattr(bl,'delta',None), utau=bl.utau, Uc=bl.Uc),
            geo=dict(chord=geo.chord, span=geo.span)
        )
        os.makedirs(path_dir, exist_ok=True)
        with open(os.path.join(path_dir, "read_check.json"), "w", encoding="utf-8") as f:
            json.dump(snap, f, indent=2)
    except Exception:
        pass

def _harmonize_delta99(delta_file, delta_prof, *, lo=0.8, hi=1.25):
    """返回 (delta_eff, source_tag, note)。仅在两者均有效时执行夹持，否则回退剖面值。"""
    if (delta_prof is not None) and (delta_prof > 0):
        if (delta_file is not None) and (delta_file > 0):
            dmin, dmax = lo*delta_prof, hi*delta_prof
            if delta_file < dmin:
                return (dmin, "file_clipped_low", f"file={delta_file:g}<lo={dmin:g}")
            if delta_file > dmax:
                return (dmax, "file_clipped_high", f"file={delta_file:g}>hi={dmax:g}")
            return (delta_file, "file_ok", "")
        return (delta_prof, "profile_fallback", "file_missing_or_nonpos")
    # 没有剖面估计时，不干预
    return (delta_file, "unknown", "no_profile_ref")

def _sanity_checks(mon, flow, bl, y, U):
    """基础一致性提醒；不改变任何数据，仅写日志。"""
    try:
        if bl.theta and bl.delta_star and (bl.theta > 0):
            H = bl.delta_star / bl.theta
            if not (1.2 <= H <= 2.2):
                mon.warn(f"[sanity] 形状因子 H=δ*/θ={H:.2f} 偏离 1.3~2.1，检查剖面/单位。")
        if bl.delta and np.max(y) < 3.0*bl.delta:
            mon.warn(f"[sanity] y_max={np.max(y):.4g} < 3δ，剖面可能过浅，高频会偏低。")
        if bl.Cf and not (3e-4 <= bl.Cf <= 3e-3):
            mon.warn(f"[sanity] Cf_TE={bl.Cf:.3e} 异常，确认 Cf_surface_xc 窗口/分位与平滑。")
    except Exception:
        pass

# =============================
# 1/3 倍频程
# =============================
def one_third_octave_centers(fmin=80.0, fmax=12000.0) -> np.ndarray:
    k = np.arange(-60,60); f0=1000.0
    centers = f0*(2.0**(k/3.0))
    return centers[(centers>=fmin)&(centers<=fmax)]

def integrate_to_bands(f: np.ndarray, Spp: np.ndarray, centers: np.ndarray, mon: Optional[Monitor]=None) -> np.ndarray:
    out = np.zeros_like(centers, dtype=float)
    f = np.asarray(f, float); Spp = np.asarray(Spp, float)
    mgood = np.isfinite(f) & np.isfinite(Spp)
    f = f[mgood]; Spp = Spp[mgood]
    order = np.argsort(f); f = f[order]; Spp = Spp[order]
    total_energy = np.trapz(Spp, f) if f.size>1 else 0.0
    for i,fc in enumerate(centers):
        fl = fc/(2.0**(1/6)); fu = fc*(2.0**(1/6))
        m  = (f>=fl)&(f<=fu)
        if np.count_nonzero(m)>=2:
            out[i] = np.trapz(Spp[m], f[m])
        elif np.count_nonzero(m)==1:
            idx = int(np.where(m)[0][0]); out[i] = Spp[idx]*(fu-fl)
        else:
            out[i] = 0.0
    if mon and total_energy>0:
        mon.info(f"[1/3-oct] coverage≈{np.sum(out)/total_energy:.3f}")
    return out

# =============================
# 用 (y, U) 拟合边界层参数
# =============================
def bl_params_from_profile(y: np.ndarray, U: np.ndarray, rho: float, mu: float,
                           Ue: Optional[float]=None, mon: Optional[Monitor]=None) -> BLParams:
    idx = np.argsort(y); y = np.asarray(y)[idx]; U = np.asarray(U)[idx]
    Ue = float(np.mean(U[-min(5,len(U)):])) if (Ue is None) else float(Ue); ue = max(Ue, 1e-9)
    dy = np.diff(y); Um = 0.5*(U[1:]+U[:-1])
    delta_star = np.sum((1.0 - Um/ue)*dy)
    theta = np.sum((Um/ue)*(1.0 - Um/ue)*dy)
    ge = (U >= 0.99*ue)
    delta_99 = y[int(np.argmax(ge))] if np.any(ge) else y[-1]
    dUdy_wall = (U[1]-U[0]) / max(y[1]-y[0], 1e-12)
    tau_w = mu * dUdy_wall; u_tau = np.sqrt(max(tau_w, 0.0)/rho)
    Cf = 2.0*(u_tau/ue)**2; Uc = 0.75*ue
    if mon:
        mon.header("BL from (y,U)")
        mon.info(f"Ue≈{ue:.3f}, θ={theta:.4e}, δ*={delta_star:.4e}, δ99={delta_99:.4e}, Cf≈{Cf:.4e}")
    return BLParams(Ue=ue, Cf=Cf, theta=theta, delta_star=delta_star, delta=delta_99, utau=u_tau, Uc=Uc)

# =============================
# 读取 amiet_inputs（含单位修正与 Cf 稳健化 + ★Step A 夹持）
# =============================
def _prefer(v: Optional[float], fb: Optional[float]) -> Optional[float]:
    return v if (v is not None and np.isfinite(v)) else fb

def _read_keyval_csv(path: str) -> Dict[str, float]:
    out: Dict[str, float] = {}
    with open(path, "r", encoding="utf-8") as fh:
        for raw in fh:
            line = raw.strip()
            if not line or line.startswith("#"): continue
            parsed = False
            for sep in [",",";","\t"," "]:
                if sep in line:
                    kv = [t for t in line.split(sep) if t]
                    if len(kv) >= 2:
                        k = kv[0].strip().lower()
                        try:
                            v = float(kv[1]); out[k]=v; parsed=True; break
                        except: pass
            if (not parsed) and ("=" in line):
                kv = line.split("=")
                if len(kv)>=2:
                    k = kv[0].strip().lower()
                    try: out[k]=float(kv[1])
                    except: pass
    return out

def _read_profile_csv(path: str) -> Dict[str, np.ndarray]:
    with open(path, "r", encoding="utf-8") as fh:
        reader = csv.reader(fh); rows = list(reader)
    if not rows: raise ValueError(f"profile empty: {path}")
    header = [h.strip().lower() for h in rows[0]]
    data = []
    for r in rows[1:]:
        if len(r) != len(header): continue
        try: data.append([float(x) for x in r])
        except: continue
    data = np.array(data, dtype=float)
    out: Dict[str, np.ndarray] = {}
    for want in ["y","u","p","rho","k","omega","nut","alphat"]:
        if want in header:
            out[want] = data[:, header.index(want)]
    if "y" not in out or "u" not in out:
        raise ValueError(f"{path}: need columns 'y' & 'U'")
    return out

def _norm_key(s: str) -> str:
    return s.strip().lower().replace(" ", "_").replace("-", "_")

def _try_float(x):
    try:
        return float(str(x).strip().replace(",", "."))
    except Exception:
        return None

def _pick_row_by_side(rows, head_norm, side_want: str, mon=None):
    side_col = None
    for j, h in enumerate(head_norm):
        if h in ("side", "surface", "face"):
            side_col = j; break
    if side_col is not None:
        want = (side_want or "").strip().upper()
        aliases = [want]
        if want == "SS": aliases += ["SUCTION", "UPPER"]
        if want == "PS": aliases += ["PRESSURE", "LOWER"]
        aliases += ["SUM", "ALL", "BOTH", "COMBINED"]
        for i in range(1, len(rows)):
            side_val = str(rows[i][side_col]).strip().upper()
            if side_val in aliases:
                if mon: mon.info(f"BL参数：匹配到 side='{side_val}' 的第 {i} 行。")
                return i, rows[i]
    for i in range(1, len(rows)):
        nums = sum(1 for v in rows[i] if _try_float(v) is not None)
        if nums >= 2:
            if mon: mon.warn(f"BL参数：未找到 side 行，改用第 {i} 行（含 {nums} 个数值列）。")
            return i, rows[i]
    return None, None

# --------- 解析 line_normal_xcXXX_[SS/PS/SUM].csv 文件名（兼容 0p98 / 0p9795 等） ---------
_profile_name_re = re.compile(r"^line_normal_xc([^_]+)_(SS|PS|SUM)\.csv$", re.IGNORECASE)

def _parse_xc_from_profile_name(fname: str) -> Optional[Tuple[float,str]]:
    m = _profile_name_re.match(fname)
    if not m:
        return None
    tag = m.group(1)   # e.g. "0p98" 或 "0.9795"
    side = m.group(2).upper()
    try:
        xc_val = float(tag.replace("p", "."))
    except ValueError:
        return None
    return xc_val, side

def _find_profile_file(amiet_dir: str, xc: float, prefer_side: str="SS",
                       mon: Optional[Monitor]=None) -> Tuple[Optional[str], Optional[str], Optional[float]]:
    """
    在 amiet_dir 中搜索所有 line_normal_xc*_SS/PS/SUM.csv：
    - 解析出 xc_file 和 side；
    - 优先选 side=prefer_side 中与 xc 最近的一个；
    - 若该侧没有，则按 SS→PS→SUM 顺序回退。
    返回 (full_path, chosen_side, xc_file)。
    """
    prefer_side = prefer_side.upper().strip() or "SS"
    files = [f for f in os.listdir(amiet_dir) if f.lower().startswith("line_normal_xc") and f.lower().endswith(".csv")]
    candidates: List[Tuple[str,float,str]] = []
    for fn in files:
        parsed = _parse_xc_from_profile_name(fn)
        if parsed is None:
            continue
        xc_file, side = parsed
        candidates.append((fn, xc_file, side))
    if not candidates:
        return None, None, None

    def _select_for_side(side: str) -> Optional[Tuple[str,float,str]]:
        arr = [c for c in candidates if c[2] == side]
        if not arr:
            return None
        arr.sort(key=lambda t: abs(t[1]-xc))
        return arr[0]

    chosen = _select_for_side(prefer_side)
    if chosen is None:
        for s in ("SS","PS","SUM"):
            chosen = _select_for_side(s)
            if chosen is not None:
                break
    if chosen is None:
        return None, None, None

    fn, xc_file, side = chosen
    full_path = os.path.join(amiet_dir, fn)
    if mon:
        mon.info(f"[profile] 目标 xc={xc:.4f}，选择文件 {fn} (xc≈{xc_file:.4f}, side={side})")
    return full_path, side, xc_file

# TE Cf 曲线读取与稳健化 —— 分位 + 放大
def _read_cf_surface(amiet_dir: str, mon: Optional[Monitor]=None) -> List[Tuple[float,float]]:
    f_cf = os.path.join(amiet_dir, "Cf_surface_xc.csv")
    if not os.path.isfile(f_cf): return []
    xs, cfs = [], []
    with open(f_cf, "r", encoding="utf-8") as fh:
        rdr = csv.reader(fh)
        rows = [r for r in rdr if r and any(t.strip() for t in r)]
    if not rows: return []
    head = [h.strip().lower() for h in rows[0]]
    def try_add(row):
        try:
            if "cf" in head and "x" in head:
                x = float(row[head.index("x")]); cf=float(row[head.index("cf")])
                if np.isfinite(x) and np.isfinite(cf): xs.append(x); cfs.append(cf)
            else:
                vals = [float(v) for v in row]
                if len(vals)>=2: xs.append(vals[0]); cfs.append(vals[-1])
        except: pass
    try:
        [float(v) for v in rows[0]]; start_idx = 0
    except:
        start_idx = 1
    for r in rows[start_idx:]:
        try_add(r)
    if mon: mon.info(f"读取 Cf_surface_xc.csv 成功：有效行数 {len(xs)}")
    return list(zip(xs, cfs))

def _pick_te_Cf_from_surface(pairs_x_cf: List[Tuple[float,float]], xc: float,
                             mon: Optional[Monitor]=None, pctl: float=60.0, K: float=1.2) -> Optional[float]:
    if not pairs_x_cf: return None
    X = np.array([p[0] for p in pairs_x_cf], float)
    C = np.array([p[1] for p in pairs_x_cf], float)
    mask = np.abs(X - float(xc)) <= 0.03
    n_win = int(np.count_nonzero(mask))
    if mon: mon.info(f"[Cf@TE] window x∈[{xc-0.03:.2f},{xc+0.03:.2f}], n={n_win} / {len(X)}")
    if n_win:
        vals = C[mask]
    else:
        order = np.argsort(X)
        keep = order[int(0.9*len(order)):]  # 取尾段逼近 TE
        vals = C[keep]
    vals = vals[np.isfinite(vals)]
    if vals.size == 0: return None
    cf_pick = float(np.percentile(vals, max(0.0, min(100.0, pctl))))
    cf_raw = cf_pick
    cf_pick *= float(K)  # 放大因子
    if mon:
        mon.info(f"[Cf@TE] p{pctl:.0f}={cf_raw:.6e}, K={K:.2f} → Cf_TE={cf_pick:.6e}")
    if not (1e-5 <= cf_pick <= 5e-2):
        if mon: mon.warn(f"Cf_TE 异常越界：{cf_pick:.3e}，将忽略。")
        return None
    return cf_pick

def read_amiet_inputs_dir(amiet_dir: str, *, xc: float=0.98, side: str="SS",
                          y_is_y_over_c: Optional[bool]=None,
                          U_units: Optional[str]=None,
                          mon: Optional[Monitor]=None, Kcfte=1.2, pctl_cfte: float=60.0):
    if mon: mon.header(f"Read amiet_inputs @ {amiet_dir}")
    fs_path = os.path.join(amiet_dir, "freestream.csv")
    if not os.path.isfile(fs_path):
        raise FileNotFoundError(f"missing: {fs_path}")
    fs = _read_keyval_csv(fs_path)

    Ma   = fs.get("ma", _prefer(fs.get("mach"), fs.get("m")))
    a    = _prefer(fs.get("a"), fs.get("asound"))
    Uinf = _prefer(fs.get("u_inf"), _prefer(fs.get("uinf"), fs.get("u")))
    rho  = _prefer(fs.get("rho"), fs.get("rhoinf"))
    mu   = _prefer(fs.get("mu"),  fs.get("muinf"))
    alpha_deg = _prefer(fs.get("alpha"), fs.get("alpha_deg"))
    Re_c = _prefer(fs.get("re"), fs.get("re_c"))
    chord = _prefer(fs.get("c"), fs.get("chord"))
    span  = _prefer(fs.get("span"), fs.get("b"))

    if rho is None or mu is None:
        raise ValueError("freestream.csv 必须包含 rho, mu")
    if Ma is None and (a is None and Uinf is None):
        raise ValueError("freestream.csv 需 Ma 与 a，或 U_inf 至少一组")
    if Ma is None and (a is not None and Uinf is not None): Ma = float(Uinf)/float(a)
    if a  is None and (Ma is not None and Uinf is not None): a  = float(Uinf)/float(Ma)
    if Uinf is None and (Ma is not None and a is not None):  Uinf = float(Ma)*float(a)
    Ma, a, Uinf = float(Ma), float(a), float(Uinf)
    rho, mu = float(rho), float(mu)
    chord = 1.0 if chord is None else float(chord)
    span  = 1.0 if span  is None else float(span)
    alpha_deg = float(_prefer(alpha_deg, 0.0))
    Re_c = float(_prefer(Re_c, (rho*Uinf*chord)/max(mu,1e-12)))

    # --------- 查找法向剖面：使用文件名解析，而不是死拼 0p98 ----------
    side_tag = str(side).upper().strip() or "SS"
    prof_path, chosen_side, xc_file = _find_profile_file(amiet_dir, xc=float(xc), prefer_side=side_tag, mon=mon)
    if prof_path is None:
        raise FileNotFoundError("缺少法向剖面：line_normal_xc*_SS/PS/SUM.csv")

    if mon:
        mon.info(f"使用法向剖面: {prof_path} （侧={chosen_side}）")
        if chosen_side == "SUM":
            mon.warn("BL 推算侧为 SUM（双侧合并），仅因单侧缺失而回退；建议提供 SS/PS 单侧剖面。")

    prof = _read_profile_csv(prof_path)
    y = prof["y"].astype(float)
    U = prof["u"].astype(float)

    # y 单位判断
    y_scaled_from_yc = False
    if y_is_y_over_c is True:
        y = y * chord
        y_scaled_from_yc = True
    elif y_is_y_over_c is False:
        pass
    else:
        if np.nanmax(np.abs(y)) < 0.2 and 0.2 <= chord <= 5.0:
            y = y * chord
            y_scaled_from_yc = True
            if mon: mon.info(f"[units] 侦测到 y≈y/c，已按 c={chord:.3f} m 缩放到 SI。")
    if mon:
        mon.info(f"[units] y-scale: {'y/c→m' if y_scaled_from_yc else 'as-is (m)'}; c={chord:.3f} m")

    # U 单位判断
    Ue_guess = float(np.mean(U[-min(5, len(U)):])); used_u_over_uinf = False; used_mach = False
    if U_units == 'mach': U = U * a; used_mach = True
    elif U_units == 'u_over_uinf': U = U * Uinf; used_u_over_uinf = True
    elif U_units == 'ms': pass
    else:
        if Ue_guess <= 2.5:
            U = U * a
            if mon: mon.warn(f"[units] U 无法明确判定（Mach 或 U/Uinf），按 Mach×a 缩放。")
        else:
            if mon: mon.info("[units] 侦测到 U 已是 m/s。")
    if mon:
        mon.info(f"[units] U-scale: {'Mach×a' if used_mach else ('(U/Uinf)×Uinf' if used_u_over_uinf else 'as-is (m/s)')}")

    # ===== BL 参数（文件优先；单位修正；缺项由剖面补齐） =====
    blp_file = os.path.join(amiet_dir, "bl_params_TE.csv")
    delta_file_scaled = None
    bl_est = None

    if os.path.isfile(blp_file):
        if mon: mon.info(f"使用 BL 参数文件: {blp_file}")
        with open(blp_file, "r", encoding="utf-8") as fh:
            rdr = csv.reader(fh)
            rows = [row for row in rdr if row and any(str(c).strip() for c in row)]
        d = {}
        if rows and len(rows) >= 2:
            head = [_norm_key(h) for h in rows[0]]
            row_idx, row_vals = _pick_row_by_side(rows, head, chosen_side or side_tag, mon)
            if row_idx is not None:
                used_cols, skipped_cols = [], []
                for j, hj in enumerate(head):
                    v = _try_float(row_vals[j]) if j < len(row_vals) else None
                    if v is not None:
                        d[hj] = v; used_cols.append(hj)
                    else:
                        skipped_cols.append(hj)
                if mon:
                    mon.info(f"BL参数：成功解析列：{used_cols}")
                    if skipped_cols: mon.warn(f"BL参数：非数值/跳过列：{skipped_cols}")
            else:
                if mon: mon.fail("BL参数：找不到可用的数据行。将回退到剖面估算。")
        def _get_any(keys, default=None):
            for k in keys:
                k2 = _norm_key(k)
                if k2 in d and d[k2] is not None:
                    return d[k2]
            return default
        Ue_file = _prefer(_get_any(["Ue","U_e","edge_velocity"]), None)
        delta   = _prefer(_get_any(["delta","delta99","bl_thickness"]), None)
        # 支持 'delta*' 或 'delta_star'
        delta_s = _prefer(_get_any(["delta_star","dstar","displacement_thickness","delta*"]), None)
        theta   = _prefer(_get_any(["theta","momentum_thickness"]), None)
        Cf_file = _prefer(_get_any(["Cf","c_f","skin_friction"]), None)

        # 单位修正：若 δ/θ/δ* 像相对弦长（<0.2），乘以 c → m
        def _maybe_scale_len(x, name):
            if x is None: return None
            if 0.2 <= chord <= 5.0 and 0.0 < x < 0.2:
                if mon: mon.info(f"[units] {name}≈(·c) 检测成立：{x:g}，按 c={chord:.3f} m → {x*chord:.6f} m")
                return x * chord
            return x
        delta   = _maybe_scale_len(delta,   "delta")
        delta_s = _maybe_scale_len(delta_s, "delta*")
        theta   = _maybe_scale_len(theta,   "theta")

        # 用剖面估算（用于夹持与兜底）
        bl_est = bl_params_from_profile(y, U, rho=rho, mu=mu, Ue=_prefer(Ue_file, None), mon=mon)

        # 先按“文件优先 + 剖面补齐”构造 bl
        Ue = _prefer(Ue_file, bl_est.Ue)
        Cf = _prefer(Cf_file, bl_est.Cf)
        theta = _prefer(theta, bl_est.theta)
        delta_s = _prefer(delta_s, bl_est.delta_star)
        delta = _prefer(delta, bl_est.delta)

        # 保存“文件 δ”的单位修正后值（若确实来自文件）
        if ("delta" in d or "delta99" in d or "bl_thickness" in d) and delta is not None:
            delta_file_scaled = float(delta)

        bl = BLParams(Ue=Ue, Cf=float(Cf), theta=float(theta), delta_star=float(delta_s),
                      delta=float(delta), utau=None, Uc=None)
    else:
        if mon: mon.warn("缺少 bl_params_TE.csv，改用 (y,U) 估算。")
        bl = bl_params_from_profile(y, U, rho=rho, mu=mu, mon=mon)
        bl_est = bl  # 剖面即最终

    # ===== Cf(TE) 覆盖：p60 × 1.2（更中性） =====
    try:
        pairs = _read_cf_surface(amiet_dir, mon)
        cf_te = _pick_te_Cf_from_surface(pairs, xc=xc, mon=mon, pctl=pctl_cfte, K=Kcfte)
        if cf_te is not None:
            bl.Cf = float(cf_te)
            bl.utau = bl.Ue * np.sqrt(max(bl.Cf, 1e-12)/2.0)
            if mon: mon.info(f"[Cf@TE] 最终采用 Cf_TE={bl.Cf:.6e}, Ue={bl.Ue:.3f} m/s, utau={bl.utau:.4f} m/s")
        else:
            if mon: mon.info("Cf_surface_xc.csv 不可用或不合理，保持 BL 中的 Cf。")
    except Exception as e:
        if mon: mon.warn(f"Cf_surface_xc 解析失败：{e}; 使用 BL 中 Cf。")

    # ===== ★ Step A：δ99 一致性“夹持” =====
    try:
        delta_prof = float(bl_est.delta) if (bl_est and getattr(bl_est, "delta", None)) else None
        delta_file = float(delta_file_scaled) if (delta_file_scaled is not None) else None
        delta_eff, dsrc, note = _harmonize_delta99(delta_file, delta_prof, lo=0.8, hi=1.25)
        if (delta_eff is not None) and (delta_eff > 0):
            if mon: mon.info(f"[δ99] profile={delta_prof}, file={delta_file} → use={delta_eff} <{dsrc}> {note}")
            bl.delta = float(delta_eff)
    except Exception as e:
        if mon: mon.warn(f"[δ99] 夹持失败：{e}")

    flow = FlowCondition(M=Ma, rho=rho, mu=mu, U_inf=Uinf, a=a)
    geo  = AirfoilGeometry(chord=float(chord), span=float(span))

    # ★ 快照 + 基础一致性提醒
    try:
        _dump_input_snapshot(amiet_dir, flow=flow, bl=bl, geo=geo,
                             chosen_side=(chosen_side or side_tag),
                             sources=dict(delta=("file" if delta_file_scaled is not None else "profile")))
        _sanity_checks(mon, flow, bl, y, U)
    except Exception:
        pass

    return flow, geo, bl, y, U

