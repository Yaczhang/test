class CFDCaseSpec:
    def __init__(self, U_inf: float, alpha_deg: float, Re_c: float, a: float=340.0):
        self.U_inf=U_inf; self.alpha=alpha_deg; self.Re_c=Re_c; self.a=a; self.M=U_inf/a
    def to_runner_vec(self, nIter: int=2000, *, kind: Literal["mach","uinf"]="mach"):
        if kind == "mach":
            return [float(self.M), float(self.Re_c), float(self.alpha), int(nIter)]
        else:
            return [float(self.U_inf), float(self.Re_c), float(self.alpha), int(nIter)]

def reconcile_uinf(Ma: float, a: float, Re_c: float, c: float, nu: float, mon: Optional[Monitor]=None) -> Tuple[float, List[str]]:
    msgs = []
    U_from_Ma = Ma*max(a,1e-9)
    U_from_Re = (Re_c*max(nu,1e-12))/max(c,1e-12)
    rel = abs(U_from_Ma - U_from_Re)/max(U_from_Ma,1e-9)
    if rel > 0.1:
        msgs.append(f"U_inf from Ma*a = {U_from_Ma:.3f}; from Re = {U_from_Re:.3f} (Δ≈{100*rel:.1f}%). Use Ma·a.")
    else:
        msgs.append(f"U_inf consistent: {U_from_Ma:.3f} vs {U_from_Re:.3f}.")
    if mon:
        mon.header("Freestream check")
        for m in msgs: mon.info(m)
    return U_from_Ma, msgs

# =============================
# 自动增益工具函数（基于参考谱）
# =============================
def _auto_gain_from_ref(
    f_model: np.ndarray,
    SPL_model: np.ndarray,
    f_ref: Optional[np.ndarray],
    SPL_ref: Optional[np.ndarray],
    mon: Optional[Monitor]=None
) -> float:
    """在 log(f) 空间把 model 插值到参考频率上，计算平均 dB 差作为自动增益"""
    if f_ref is None or SPL_ref is None:
        if mon: mon.info("[gain_auto] 未提供参考谱，跳过自动增益。")
        return 0.0
    f_model = np.asarray(f_model, float)
    SPL_model = np.asarray(SPL_model, float)
    f_ref = np.asarray(f_ref, float)
    SPL_ref = np.asarray(SPL_ref, float)
    m = np.isfinite(f_ref) & np.isfinite(SPL_ref)
    f_ref = f_ref[m]; SPL_ref = SPL_ref[m]
    if f_ref.size < 2:
        if mon: mon.warn("[gain_auto] 参考谱有效点少于 2，跳过自动增益。")
        return 0.0
    if np.any(f_model <= 0) or np.any(f_ref <= 0):
        if mon: mon.warn("[gain_auto] 频率中含非正值，跳过自动增益。")
        return 0.0
    logf_mod = np.log10(f_model)
    logf_ref = np.log10(f_ref)
    SPL_mod_on_ref = np.interp(logf_ref, logf_mod, SPL_model, left=np.nan, right=np.nan)
    m2 = np.isfinite(SPL_mod_on_ref)
    if np.count_nonzero(m2) < 2:
        if mon: mon.warn("[gain_auto] 插值后有效重叠点不足，跳过自动增益。")
        return 0.0
    diff = SPL_ref[m2] - SPL_mod_on_ref[m2]
    gain_db = float(np.nanmean(diff))
    if mon: mon.info(f"[gain_auto] 自动增益 = {gain_db:+.2f} dB（在 {np.count_nonzero(m2)} 个频点上拟合）")
    return gain_db

# ===== 基于参考 1/3 倍频程谱的“频率幂次”标定 =====
def _wps_powerlaw_slope_from_ref(
    centers_model: np.ndarray,
    band_SPL_model: np.ndarray,
    f_ref_points: np.ndarray,
    SPL_ref_points: np.ndarray,
    f_ref0: float = 1000.0,
    mon: Optional[Monitor] = None,
) -> Tuple[float, float]:
    """
    根据参考 1/3 倍频程谱，拟合一个简单的幂次修正：
        ΔSPL(f) ≈ A + B·log10(f/f_ref0)
    等价于在功率谱上乘：
        Spp_new = K0 · (f/f_ref0)^p · Spp_old
    返回 (K0, p)。若拟合失败则返回 (1.0, 0.0) 表示“不修正”。
    """
    centers_model = np.asarray(centers_model, float)
    band_SPL_model = np.asarray(band_SPL_model, float)
    f_ref_points = np.asarray(f_ref_points, float)
    SPL_ref_points = np.asarray(SPL_ref_points, float)

    m = np.isfinite(f_ref_points) & np.isfinite(SPL_ref_points) & (f_ref_points > 0.0)
    f_ref = f_ref_points[m]
    SPL_ref = SPL_ref_points[m]
    if f_ref.size < 3:
        if mon:
            mon.warn("[wps_calib] 参考谱有效点少于 3，跳过谱斜率标定。")
        return 1.0, 0.0

    if np.any(centers_model <= 0.0):
        if mon:
            mon.warn("[wps_calib] 模型 1/3 倍频程中心频率含非正值，跳过谱斜率标定。")
        return 1.0, 0.0

    # 在 log(f) 空间把模型 1/3 倍频程谱插值到参考频率
    logf_mod = np.log10(centers_model)
    logf_ref = np.log10(f_ref)
    SPL_mod_on_ref = np.interp(
        logf_ref, logf_mod, band_SPL_model, left=np.nan, right=np.nan
    )
    m2 = np.isfinite(SPL_mod_on_ref)
    if np.count_nonzero(m2) < 3:
        if mon:
            mon.warn("[wps_calib] 模型与参考谱重叠有效点少于 3，跳过谱斜率标定。")
        return 1.0, 0.0

    f_fit = f_ref[m2]
    err = SPL_ref[m2] - SPL_mod_on_ref[m2]

    # 拟合 err = A + B·log10(f/f_ref0)
    logf_rel = np.log10(f_fit / max(f_ref0, 1.0))
    X = np.vstack([np.ones_like(logf_rel), logf_rel]).T
    try:
        A, B = np.linalg.lstsq(X, err, rcond=None)[0]
    except Exception as e:
        if mon:
            mon.warn(f"[wps_calib] 最小二乘拟合失败：{e}；跳过谱斜率标定。")
        return 1.0, 0.0

    K0 = 10.0 ** (A / 10.0)
    p = B / 10.0
    if mon:
        mon.info(
            f"[wps_calib] 拟合 ΔSPL≈{A:+.2f} + {B:+.2f}·log10(f/{f_ref0:.0f}) → "
            f"K0={K0:.3e}, p={p:.3f}"
        )
    return float(K0), float(p)

# =============================
# 主流程
# =============================
def run_case_and_predict_SPL(case: 'CFDCaseSpec',
                             chord: float, span: float,
                             rho: float, mu: float,
                             observer_R_theta_phi: Tuple[float,float,float],
                             runner_obj=None,
                             airfoil_dir:str=None, airfoil_file:str=None,
                             nIter:int=2000,
                             beta_z:float=1.40,
                             L_span:float=0.58,
                             K_cal :float=4.0,
                             wps_fn: Callable[[np.ndarray, FlowCondition, BLParams], np.ndarray]=None,
                             f: np.ndarray = None,
                             model: str="amiet_rozenberg",
                             tno_side: str="SS",
                             level_correction_db: float=0.0,
                             diagnostics_dir: Optional[str]=None,
                             rozenberg_tuning: RozenbergTuning = RozenbergTuning(),
                             backend: str="runner",
                             openfoam_cfg: Optional[Dict[str,Any]] = None,
                             # ===== TE 核（物理中性缺省） =====
                             lowfreq_gain_k =1.0,
                             te_model: str = "amiet76",
                             beta_fb: float = 600.0,
                             beta_nb: float = 1.0,
                             hf_tilt_n: float = 1.0,
                             hf_f0: float = 7000.0,
                             lf_shelf_k: float = 1.0,
                             lf_f0: float = 350.0,
                             lf_n: float = 2.0,
                             delta99_scale: float = 1.0,
                             K_cfte: float = 1.2,
                             mf_boost_k: float = 1.0,
                             mf_f0: float = 1600.0,
                             mf_n: float = 1.3,
                             geom_norm: str = "4piR2",
                             span_model: str = "hybrid",
                             phi_units: str = "Pa2_per_Hz",
                             corr_len_scale: float = 0.0,
                             span_hybrid_kyL_thresh: float = math.pi,
                             span_hybrid_blend_width: float = 0.6,
                             # ===== 自动增益（可选） =====
                             gain_auto: bool=False,
                             gain_auto_ref_freq: Optional[np.ndarray]=None,
                             gain_auto_ref_SPL: Optional[np.ndarray]=None,
                             # ===== 壁压谱“频率幂次”标定（可选） =====
                             wps_slope_calib: bool=False,
                             wps_f_ref: float=1000.0,
                             wps_calib_ref_freq: Optional[np.ndarray]=None,
                             wps_calib_ref_SPL: Optional[np.ndarray]=None,
                             ) -> Dict[str, Any]:

    mon = Monitor(name="diag", save_dir=diagnostics_dir)
    U_from_Ma, _ = reconcile_uinf(case.M, case.a, case.Re_c, chord, mu/max(rho,1e-12), mon)
    case = CFDCaseSpec(U_inf=U_from_Ma, alpha_deg=case.alpha, Re_c=case.Re_c, a=case.a)

    flow = FlowCondition(M=case.M, rho=rho, mu=mu, U_inf=case.U_inf, a=case.a, Uc_factor=rozenberg_tuning.Uc_factor)
    geo  = AirfoilGeometry(chord=chord, span=span)
    R, th, ph = observer_R_theta_phi
    obs  = Observer(R=R, theta=th, phi=ph)

    if backend.lower() == "runner":
        if runner_obj is None or (airfoil_dir is None) or (airfoil_file is None):
            raise RuntimeError("backend='runner' 需要 runner_obj, airfoil_dir, airfoil_file")
        if read_profile_from_field is None:
            raise RuntimeError("缺少 amiet_data.read_profile_from_field")
        vec = case.to_runner_vec(nIter, kind="mach")
        res = runner_obj.simu_fmt(airfoil_dir, airfoil_file, vec,
                                  getattr(runner_obj,'simu_core',0),
                                  getattr(runner_obj,'path_save', None))
        save_dirs = getattr(res, 'save_dirs', None)
        if save_dirs is None:
            raise FileNotFoundError("CFD 运行未返回 save_dirs")
        y, U = read_profile_from_field(
            save_dirs=save_dirs, airfoil_name="NACA0012",
            Ma=case.M, alpha_deg=case.alpha, Re_c=case.Re_c,
            chord=chord, airfoil_dir=airfoil_dir, airfoil_file=airfoil_file,
            flow_a=flow.a, flow_Uinf=case.U_inf,
            x_over_c=0.98, y_max_over_c=0.06, n_sample=600,
            dat_dir_key='field', vel_source="mach", vel_comp="mag", vel_norm="mach",
            mon=mon
        )
        bl = bl_params_from_profile(y, U, rho=rho, mu=mu, mon=mon)

    elif backend.lower() == "openfoam":
        if build_and_run_with_gmsh is None or amiet_presets is None:
            raise RuntimeError("openfoam 后端不可用（openfoam.py 未加载或导入失败）")
        if openfoam_cfg is None:
            raise RuntimeError("backend='openfoam' 需要 openfoam_cfg")
        Ma = case.M
        amiet_level = str(openfoam_cfg.get("amiet_level", "medium"))
        case_tag = f"NACA0012_fromTemplate_Ma{Ma:.3f}_A{case.alpha:.1f}_N{int(max(nIter,1))}_{amiet_level}"
        OUT_ROOT = openfoam_cfg["OUT_ROOT"]
        case_dir = os.path.join(OUT_ROOT, case_tag)
        
        side = str(openfoam_cfg.get("side","SS")).upper()
        mon.info(f"[openfoam] case_dir = {case_dir}")

        amiet_dir = os.path.join(case_dir, "amiet_inputs")
        os.makedirs(amiet_dir, exist_ok=True)
        log_path = os.path.join(amiet_dir, "of_import.log")

        TEMPLATE_GEO = openfoam_cfg["TEMPLATE_GEO"]
        TEMPLATE_SYS = openfoam_cfg["TEMPLATE_SYS"]
        GMSH_EXE     = openfoam_cfg.get("GMSH_EXE", r"D:\software\gmsh\gmsh.exe")
        nproc = int(openfoam_cfg.get("nproc", 8))
        aInf  = float(openfoam_cfg.get("aInf", 340.17))
        rhoInf= float(openfoam_cfg.get("rhoInf", 1.225))
        P = amiet_presets(amiet_level)
        xc = float(openfoam_cfg.get("xc", P["te_x"]))
        gamma=1.4; Rgas=287.058; Cp=1004.5; mu_of=1.8e-5; Pr=0.71; Prt=0.85

        try:
            # 尝试直接对已有 case_dir 做 export + ensure（不重算 CFD）
            export_amiet_inputs(
                Path(case_dir),
                Ma=Ma, U_inf=Ma*aInf, rhoInf=rhoInf,
                aInf=aInf, alpha_deg=case.alpha, mu=mu_of
            )
            amiet_dir = ensure_amiet_inputs(str(case_dir), xc=xc, mon=mon)
        except Exception as e:
            mon.warn(f"[openfoam] 直接从 {case_dir} 导出 amiet_inputs 失败，将尝试重新运行 CFD：{e}")
            if (airfoil_dir is None) or (airfoil_file is None):
                raise RuntimeError("openfoam 路线需要 airfoil_dir / airfoil_file") from e
            mon.header("启动 OpenFOAM 求解以生成缺失数据")
            case_path = build_and_run_with_gmsh(
                case_root=Path(OUT_ROOT),
                name_tag=case_tag,
                airfoil_dat=Path(os.path.join(airfoil_dir, airfoil_file)),
                template_system_root=Path(TEMPLATE_SYS),
                Ma=Ma, Re=case.Re_c, alpha_deg=case.alpha, nSteps=int(nIter), nproc=nproc,
                amiet_level=amiet_level,
                template_geo=Path(TEMPLATE_GEO),
                gmsh_exe_win=Path(GMSH_EXE),
                gamma=gamma, Rgas=Rgas, Cp=Cp, mu=mu_of, Pr=Pr, Prt=Prt,
                rhoInf=rhoInf, aInf=aInf,
                patch_name_for_forces="airfoil"
            )
            export_amiet_inputs(
                case_path,
                Ma=Ma, U_inf=Ma*aInf, rhoInf=rhoInf,
                aInf=aInf, alpha_deg=case.alpha, mu=mu_of
            )
            amiet_dir = ensure_amiet_inputs(str(case_path), xc=xc, mon=mon)

        mon.dump_extra(log_path)

        flow2, geo2, bl, y, U = read_amiet_inputs_dir(
            amiet_dir, xc=xc, side=side, mon=mon, Kcfte=K_cfte, pctl_cfte=60.0
        )
        flow = flow2
        geo = AirfoilGeometry(
            chord=float(chord if chord is not None else geo2.chord),
            span=float(span  if span  is not None else geo2.span)
        )
        mon.dump_extra(log_path)

    elif backend.lower() == "of_files":
        xc = 0.98
        
        if openfoam_cfg is None or ("amiet_dir" not in openfoam_cfg):
            raise RuntimeError("backend='of_files' 需 openfoam_cfg={'amiet_dir': '...'}")
        amiet_dir = openfoam_cfg["amiet_dir"]
        # 为 of_files 单独提供一个默认 TE 位置，不能引用未定义的 xc
        xc_local = float(openfoam_cfg.get("xc", xc))
        side = openfoam_cfg.get("side", "SS")
        flow2, geo2, bl, y, U = read_amiet_inputs_dir(
            amiet_dir, xc=xc_local, side=side, mon=mon, Kcfte=K_cfte, pctl_cfte=60.0
        )
        flow = flow2
        geo  = AirfoilGeometry(
            chord=float(chord if chord is not None else geo2.chord),
            span=float(span  if span  is not None else geo2.span)
        )
    else:
        raise ValueError("backend 只能为 'runner'、'openfoam' 或 'of_files'")

    # [FIX] 默认情况下，bl_eff 先等于 bl；Rozenberg 分支会再做 δ99 缩放
    bl_eff = bl

    nu = flow.mu/flow.rho
    Re_from_inputs = flow.rho*case.U_inf*geo.chord/flow.mu
    print(f"[CHK] Re(c): freestream={case.Re_c:.3e}, recomputed={Re_from_inputs:.3e}, "
          f"Δ={abs(Re_from_inputs-case.Re_c)/case.Re_c*100:.1f}%")
    cf_back = 2*(bl.utau/bl.Ue)**2
    print(f"[CHK] Cf(back-calc)={cf_back:.6e}, Cf(TE_used)={bl.Cf:.6e}")
    Re_tau = bl.utau*bl.delta/nu
    print(f"[CHK] Re_tau ~ {Re_tau:.0f} (δ= {bl.delta:.4e} m, ν= {nu:.2e} m^2/s)")

    # ★ 再做一次轻量 sanity 提醒（不改变结果）
    _sanity_checks(mon, flow, bl, y, U)

    if f is None:
        f = np.logspace(np.log10(200.0), np.log10(10000.0), 400)

    if model.lower() == "amiet_rozenberg":
        Ue = getattr(flow, "Ue", flow.U_inf)
        flow.Uc = rozenberg_tuning.Uc_factor * Ue

        # ===== ★ 统一 Rozenberg 与 TE 核的有效 δ99 =====
        try:
            delta_raw = getattr(bl, "delta", None)
            if (delta_raw is not None) and (delta_raw > 0.0):
                scale = float(delta99_scale)
                delta_eff = delta_raw * scale
                if abs(scale - 1.0) > 1e-6:
                    mon.info(f"[δ99_eff] raw={delta_raw:.4e} m, scale={scale:.3f} → δ99_eff={delta_eff:.4e} m")
                bl_eff = BLParams(Ue=bl.Ue, Cf=bl.Cf, theta=bl.theta,
                                  delta_star=bl.delta_star, delta=delta_eff,
                                  utau=bl.utau, Uc=bl.Uc, APG_pi=bl.APG_pi)
        except Exception as e:
            mon.warn(f"[δ99_eff] 有效 δ99 构造失败，回退使用原始 δ99：{e}")
            bl_eff = bl

        # Rozenberg 使用 bl_eff
        _wps = (lambda ff, fl, blp: wps_rozenberg2012(ff, fl, blp, mon, rozenberg_tuning)) \
               if (wps_fn is None) else (lambda ff,fl,blp: wps_fn(ff, fl, blp))
        Phi = _wps(f, flow, bl_eff)

        # 让 flow.delta99 与 bl_eff 一致（供 _require_delta99 兜底）
        try:
            setattr(flow, "delta99", float(getattr(bl_eff, "delta", None)))
        except Exception:
            pass

        # TE 核同样使用 bl_eff 的 δ99；此处 delta99_scale=1.0（避免二次缩放）
        Spp = amiet_compact_te_Spp(
            f, Phi, flow, geo, obs, mon,
            bl=bl_eff,
            Uc_factor=rozenberg_tuning.Uc_factor,
            te_model=te_model,
            lowfreq_gain_k=lowfreq_gain_k,
            beta_z=beta_z,
            L_span=L_span, K_cal=K_cal,
            phi_units=phi_units,
            corr_len_scale=corr_len_scale,
            beta_fb=beta_fb, beta_nb=beta_nb,
            hf_tilt_n=hf_tilt_n, hf_f0=hf_f0,
            lf_shelf_k=lf_shelf_k, lf_f0=lf_f0, lf_n=lf_n,
            delta99_scale=1.0,
            mf_boost_k=mf_boost_k, mf_f0=mf_f0, mf_n=mf_n,
            geom_norm=geom_norm,
            span_model=span_model,
            span_hybrid_kyL_thresh = span_hybrid_kyL_thresh,
            span_hybrid_blend_width = span_hybrid_blend_width,
        )
    else:
        Spp = _tno_nguyen2018_route(f, y, U, flow, geo, obs, bl, side=tno_side, mon=mon)

    P_REF = 20e-6
    Spp_safe = np.maximum(Spp, 1e-30)

    # 先算一遍原始的线谱 + 1/3 倍频程谱
    centers_full = one_third_octave_centers(80, 12000)
    SPL_line = 10.0 * np.log10(Spp_safe / (P_REF**2)) + float(level_correction_db)
    band_Spp = integrate_to_bands(f, Spp_safe, centers_full, mon)
    band_SPL = 10.0 * np.log10(np.maximum(band_Spp, 1e-30) / (P_REF**2)) + level_correction_db

    # ===== 可选：Rozenberg / WPS 频率幂次标定（校正斜率） =====
    if wps_slope_calib and (wps_calib_ref_freq is not None) and (wps_calib_ref_SPL is not None):
        K0_slope, p_slope = _wps_powerlaw_slope_from_ref(
            centers_full,
            band_SPL,
            wps_calib_ref_freq,
            wps_calib_ref_SPL,
            f_ref0=wps_f_ref,
            mon=mon,
        )
        if (abs(K0_slope - 1.0) > 1e-6) or (abs(p_slope) > 1e-6):
            f_safe = np.maximum(np.asarray(f, float), 1.0)
            slope_factor = K0_slope * (f_safe / max(wps_f_ref, 1.0)) ** p_slope
            Spp_safe = Spp_safe * slope_factor
            # 幂次修正作用在 Spp 上后，重新计算 SPL_line 与 1/3 倍频程谱
            SPL_line = 10.0 * np.log10(np.maximum(Spp_safe, 1e-30) / (P_REF**2)) + float(level_correction_db)
            band_Spp = integrate_to_bands(f_safe, Spp_safe, centers_full, mon)
            band_SPL = 10.0 * np.log10(np.maximum(band_Spp, 1e-30) / (P_REF**2)) + level_correction_db
            mon.info(
                f"[wps_calib] 已对 Spp 施加频率幂函数修正："
                f"K0={K0_slope:.3e}, p={p_slope:.3f} (ref={wps_f_ref:.1f} Hz)"
            )
        else:
            mon.info("[wps_calib] 拟合得到 K0≈1, p≈0，不对谱做幂次修正。")
    else:
        if wps_slope_calib:
            mon.info("[wps_calib] 参考谱缺失（freq 或 SPL 为 None），跳过谱斜率标定。")

    # ===== 可选：基于参考 1/3 倍频程谱的自动增益（仅做常数平移） =====
    auto_gain_db = 0.0
    if gain_auto:
        if gain_auto_ref_freq is not None and gain_auto_ref_SPL is not None:
            auto_gain_db = _auto_gain_from_ref(
                centers_full, band_SPL, gain_auto_ref_freq, gain_auto_ref_SPL, mon
            )
        else:
            mon.info("[gain_auto] 未提供 gain_auto_ref_freq / gain_auto_ref_SPL，无法自动校准。")
    if auto_gain_db != 0.0:
        SPL_line = SPL_line + auto_gain_db
        band_SPL = band_SPL + auto_gain_db
        mon.info(f"[gain_auto] 已对 SPL_line 与 band_SPL 施加 {auto_gain_db:+.2f} dB 自动校正。")

    # 最终线谱统计（包含幂次修正 + 自动增益）
    mon.header("Final SPL (line)")
    mon.info(
        "SPL (min,max,mean) = "
        f"{np.nanmin(SPL_line):.1f}, {np.nanmax(SPL_line):.1f}, {np.nanmean(SPL_line):.1f} dB ; "
        f"correction={level_correction_db:+.1f} dB"
    )

    mon.dump("diag_case.txt")

    return {
        'case':case,
        'flow':flow,
        'bl': bl_eff if model.lower()=="amiet_rozenberg" else bl,
        'SPL':SPL_line,
        'Spp':Spp_safe,
        'f':f,
        'geo':geo,
        'obs':obs,
        'qc':[],
        'band_centers':centers_full,
        'band_SPL':band_SPL
    }

