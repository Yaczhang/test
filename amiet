@dataclass
class RozenbergTuning:
    a1: float=0.50
    b1: float=3.70
    a2: float=0.65
    chi_exp1: float=0.70
    chi_exp2: float=6.50
    lowfreq_gain_k: float=0.60
    lowfreq_chi0: float=0.20
    Uc_factor: float=0.70   # 建议使用 0.70，更贴近 Rozenberg 原始设定
    

def wps_goody2004(f: np.ndarray, flow: FlowCondition, bl: BLParams, mon: Optional[Monitor]=None) -> np.ndarray:
    rho, ut = flow.rho, bl.utau
    Uc = max(flow.Uc_factor*bl.Ue, 1e-12)
    delta = max(bl.delta, 1e-12)
    two_pi = 2.0*np.pi
    A = (rho**2) * (ut**4) * (delta / Uc)
    chi = two_pi * f * delta / Uc
    a1, b1, a2 = 0.5, 3.7, 0.75
    G = (chi**2) / (((chi**0.75 + a1)**b1) * (1.0 + (chi/max(a2,1e-12))**7.0))
    Phi = A * G
    if mon:
        mon.header("Goody Φqq")
        mon.info(f"Uc={Uc:.3f}, A={A:.3e}, chi∈[{np.min(chi):.3g},{np.max(chi):.3g}]")
        mon.info("[units] Φqq assumed as Pa^2/Hz")
    return Phi

# ---------------- Rozenberg 2012（单位固定为 Pa²/Hz） ----------------
def _tget(tuning, key, default):
    try:
        if tuning is None: return default
        if isinstance(tuning, dict): return tuning.get(key, default)
        if hasattr(tuning, key):
            val = getattr(tuning, key)
            return default if val is None else val
    except Exception:
        pass
    return default

def wps_rozenberg2012(freqs_hz, flow, bl, mon=None, tuning=None):
    f  = np.asarray(freqs_hz, float)
    rho = float(getattr(flow, "rho", 1.225))
    a0  = float(getattr(flow, "a",   340.0))
    # Ue：优先 flow.Ue，再退 Uinf，再退 Ma*a
    Ue_attr = getattr(flow, "Ue", None)
    if Ue_attr is None:
        Uinf_attr = getattr(flow, "Uinf", None)
        if Uinf_attr is not None: Ue = float(Uinf_attr)
        else:
            M_attr = getattr(flow, "M", None)
            if M_attr is None:
                raise ValueError("Rozenberg 需要 Ue 或 Uinf 或 (M 与 a)")
            Ue = float(M_attr) * a0
    else:
        Ue = float(Ue_attr)
    # Uc
    Uc_attr = getattr(flow, "Uc", None)
    if Uc_attr is not None: Uc = float(Uc_attr)
    else: Uc = float(_tget(tuning, "Uc_factor", 0.75)) * Ue
    # δ99
    delta99 = None
    for holder in (bl, flow):
        if holder is None: continue
        for name in ("delta99", "delta_99", "delta"):
            if hasattr(holder, name) and getattr(holder, name) is not None:
                delta99 = float(getattr(holder, name)); break
        if delta99 is not None: break
    if not (delta99 and delta99 > 0):
        raise ValueError("Rozenberg 需要 delta99（m）。")
    # utau
    utau_attr = getattr(bl, "utau", None)
    if utau_attr is not None: utau = float(utau_attr)
    else:
        Cf_TE = None
        for holder in (bl, flow):
            if holder is None: continue
            for nm in ("Cf_TE", "CfTE", "Cf", "cf"):
                if hasattr(holder, nm) and getattr(holder, nm) is not None:
                    Cf_TE = float(getattr(holder, nm)); break
            if Cf_TE is not None: break
        if Cf_TE is None:
            raise ValueError("Rozenberg 需要 utau 或 Cf_TE（用于 utau=√(Cf/2)·Ue）")
        utau = np.sqrt(0.5*Cf_TE) * Ue
    # 频率无量纲
    chi = (2.0*np.pi*f*delta99) / max(Uc, 1e-9)
    # 形状函数（与结论一致化）
    a1  = float(_tget(tuning, "a1", 0.5))
    b1  = float(_tget(tuning, "b1", 3.7))
    a2  = float(_tget(tuning, "a2", 0.65))
    e1  = float(_tget(tuning, "chi_exp1", 0.7))
    e2  = float(_tget(tuning, "chi_exp2", 6.5))
    low_k = float(_tget(tuning, "lowfreq_gain_k", 0.6))
    chi0  = float(_tget(tuning, "lowfreq_chi0",   0.2))
    lowcorr = 1.0 + (low_k - 1.0) * np.exp(- (chi/chi0)**2 )
    G_low  = 1.0 / (1.0 + (chi/e1)**b1)
    G_high = (chi**2) / (1.0 + (chi/a2)**e2)
    G0     = lowcorr * (a1*G_low + (1.0 - a1)*G_high)
    # 前因子
    A = (rho**2) * (utau**4) * (delta99 / max(Uc, 1e-9))
    Phi = A * G0
    if mon:
        mon.info("======== Rozenberg Φqq (fixed-units, tuning-compatible) ========")
        mon.info(f"rho={rho:.3f}, a0={a0:.2f}, Ue={Ue:.3f}, Uc={Uc:.3f}, utau={utau:.5f}, delta99={delta99:.5f}")
        mon.info(f"A = rho^2*utau^4*(δ/Uc) = {A:.3e}")
        mon.info("[units] Φqq assumed as Pa^2/Hz (point PSD)")
    return Phi

# =============================
# Amiet 紧致 TE 核（增强 + 混合跨度）
# =============================
def _mon_kv(mon, key, val):
    if mon is None: return
    try:
        if hasattr(mon, "kv"): mon.kv(key, val)
        elif hasattr(mon, "info"): mon.info(f"{key}={val}")
        elif hasattr(mon, "log"): mon.log(f"{key}={val}")
        elif hasattr(mon, "write"): mon.write(f"{key}={val}")
    except Exception:
        pass

def _amiet_te_kernel_full(
    freqs_hz: np.ndarray,
    Phi_qq: np.ndarray,
    Uc: float, Ue: float, c0: float, rho0: float,
    L_span: float, R: float,
    theta_deg: float, phi_deg: float,
    delta99: float,
    *,
    te_model: str = "amiet76",
    lowfreq_gain_k: float = 1.0,               # 物理中性
    beta_z: float = 1.4,                       # 推荐值更新：1.4
    beta_fb: float = 600.0,                    # 推荐：600
    beta_nb: float = 1.0,                      # 推荐：1.0
    hf_tilt_n: float = 1.0,                    # 轻 roll-off
    hf_f0: float = 7000.0,
    lf_shelf_k: float = 1.0,                   # 关闭低频搁架
    lf_f0: float = 350.0,
    lf_n: float = 2.0,
    phi_units: str = "Pa2_per_Hz",
    corr_len_scale: float = 0.0,
    mon=None,
    K_cal: float = 2.0,
    mf_boost_k: float = 1.0,                   # 关闭中频鼓包
    mf_f0: float = 1600.0,
    mf_n: float = 1.5,
    geom_norm: str = "4piR2",                  # 默认 (4πR)^2
    span_model: str = "hybrid",                # 默认混合
    span_hybrid_kyL_thresh: float = math.pi,
    span_hybrid_blend_width: float = 0.6,
) -> np.ndarray:
    eps = 1e-15
    f   = np.asarray(freqs_hz, float); omega = 2.0*np.pi*f
    k0  = omega/(c0+eps); k1 = omega/(Uc+eps)
    theta = np.deg2rad(theta_deg); phi = np.deg2rad(phi_deg)
    M = Ue/(c0+eps)
    D = (np.sin(theta)**2)/((1.0 - M*np.cos(theta))**2 + eps)

    # 几何：默认 (4πR)^2
    gn = str(geom_norm).lower()
    if gn in ("4pir2","4pir^2","4pir2_norm","4pir2_normed","4pir2.0","4pir2 "):
        geom = 1.0 / (4.0*np.pi*max(R,1e-9))**2
    elif gn == "r2":
        geom = 1.0 / (max(R,1e-9)**2)
    else:
        geom = 1.0 / (4.0*np.pi*max(R,1e-9))**2

    # 展向项：finite / random / hybrid
    ky = k0*np.sin(theta)*np.cos(phi)
    model = str(span_model).lower()

    def finite_span_term(ky_):
        span_arg = (ky_ * L_span) / (2.0*np.pi + eps)  # sinc 的 π 归一
        return (np.sinc(span_arg)**2) * (L_span**2)

    def random_span_term(ky_):
        denom = 1.0 + (np.maximum(f,1.0)/max(beta_fb,1.0))**max(beta_nb,1e-6)
        Lambda_z_f = max(1e-6, beta_z*delta99) / denom
        return (2.0*Lambda_z_f * L_span) / (1.0 + (ky_*Lambda_z_f)**2)

    if model == "finite":
        S_span = finite_span_term(ky)
        corr_factor = 1.0
    elif model == "random":
        S_span = random_span_term(ky)
        corr_factor = 1.0 if phi_units == "Pa2_per_Hz" else 2.0*max(1e-12, corr_len_scale*delta99)
    else:  # hybrid
        S_fin = finite_span_term(ky)
        S_rnd = random_span_term(ky)
        kyL = np.abs(ky)*L_span
        x0 = float(span_hybrid_kyL_thresh)
        w  = max(1e-6, float(span_hybrid_blend_width))
        t  = 1.0/(1.0 + np.exp(-(kyL - x0)/w))   # 0→1
        S_span = (1.0 - t)*S_fin + t*S_rnd
        corr_factor = 1.0

    # TE 转移
    tmdl = str(te_model).lower()
    if tmdl == "amiet76":
        mu = (k1*delta99)*(1.0 - M*np.cos(theta))/(1.0 + np.cos(theta) + eps)
        H2 = 1.0/(1.0 + mu**2)
    elif tmdl == "roger2005":
        a_eff = 0.8*delta99
        ka    = k1*a_eff
        H2    = (ka**2)/(1.0 + ka**2)
    else:
        H2 = np.ones_like(k1)

    # 高频/低频形状
    if hf_tilt_n > 0.0:
        H2 = H2 / (1.0 + (np.maximum(f,1.0)/max(hf_f0,1.0))**hf_tilt_n)
    LF_shape = 1.0 if lf_shelf_k <= 0 else 1.0 + (lf_shelf_k - 1.0)/(1.0 + (f/lf_f0)**lf_n)
    LF = float(lowfreq_gain_k)

    # 组合
    Spp = D * geom * S_span * H2 * LF * corr_factor * Phi_qq
    Spp *= LF_shape

    # 中频鼓包（默认关闭）
    if mf_boost_k != 1.0:
        logf  = np.log10(np.maximum(f, 1e-9))
        logc  = np.log10(max(mf_f0, 1.0))
        sigma = np.log10(1.0 + max(mf_n, 1e-6))
        M_mid = 1.0 + (mf_boost_k - 1.0) * np.exp(-((logf - logc)**2) / (2.0 * sigma**2))
        Spp  *= M_mid
        _mon_kv(mon, "mid-bump", {"mf_boost_k": mf_boost_k, "mf_f0": mf_f0, "mf_n": mf_n})

    # 记账
    if f.size:
        i0 = np.searchsorted(f, 1000.0); i0 = min(max(i0,0), f.size-1)
        gain_ledger = {
            "f0_Hz": float(f[i0]),
            "D_dir": float(D),
            "geom": float(geom),
            "S_span": float(S_span[i0] if np.ndim(S_span) else S_span),
            "|H_TE|^2": float(H2[i0] if np.ndim(H2) else H2),
            "LF_gain": float(LF),
            "LF_shape": float(LF_shape[i0] if np.ndim(LF_shape) else LF_shape),
            "Phi_qq": float(Phi_qq[i0]),
            "corr_factor": float(1.0),
            "geom_norm": geom_norm, "span_model": model,
        }
        _mon_kv(mon, "GAIN_LEDGER@1kHz", gain_ledger)
    return Spp * K_cal

# 与原项目签名兼容的包装器
def amiet_compact_te_Spp(
    f: np.ndarray,
    Phi_pp: np.ndarray,
    flow, geo, obs, mon=None,
    *,
    bl=None,
    Uc_factor: float = 0.75,
    te_model: str = "amiet76",
    K_cal: float = 2.0,
    lowfreq_gain_k: float = 1.0,
    beta_z: float = 1.4,
    L_span: float = 0.58,
    phi_units: str = "Pa2_per_Hz",
    corr_len_scale: float = 0.0,
    beta_fb: float = 600.0,
    beta_nb: float = 1.0,
    hf_tilt_n: float = 1.0,
    hf_f0: float = 7000.0,
    lf_shelf_k: float = 1.0,
    lf_f0: float = 350.0,
    lf_n: float = 2.0,
    delta99_scale: float = 1.0,
    mf_boost_k: float = 1.0,
    mf_f0: float = 1600.0,
    mf_n: float = 1.5,
    geom_norm: str = "4piR2",
    span_model: str = "hybrid",
    span_hybrid_kyL_thresh: float = math.pi,
    span_hybrid_blend_width: float = 0.6,
) -> np.ndarray:
    f = np.asarray(f, float)
    Phi_pp = np.asarray(Phi_pp, float)
    if Phi_pp.shape != f.shape:
        raise ValueError("Phi_pp must have same shape as f")
    c0  = float(getattr(flow, "a", 340.0))
    rho = float(getattr(flow, "rho", 1.225))

    Ue = getattr(flow, "Ue", None)
    if Ue is None:
        if hasattr(flow, "Uinf") and (flow.Uinf is not None): Ue = float(flow.Uinf)
        elif hasattr(flow, "M") and (flow.M is not None): Ue = float(flow.M) * c0
        else: raise ValueError("flow 需提供 Ue 或 Uinf 或 (M 与 a)")
    Uc = float(getattr(flow, "Uc", Uc_factor*Ue))
    L  = max(float(getattr(geo, "span", 0.0)), 1e-9)
    R  = float(getattr(obs, "R", 1.0))
    theta_deg = np.degrees(float(getattr(obs, "theta", 0.5*np.pi)))
    phi_deg   = np.degrees(float(getattr(obs, "phi", 0.0)))

    # δ99（带兜底）并做轻微缩放
    delta99 = _require_delta99(flow, bl, mon) * float(delta99_scale)

    Spp = _amiet_te_kernel_full(
        freqs_hz=f,
        Phi_qq=Phi_pp,
        Uc=Uc, Ue=Ue, c0=c0, rho0=rho,
        L_span=L, R=R,
        theta_deg=theta_deg, phi_deg=phi_deg,
        delta99=delta99,
        te_model=te_model,
        lowfreq_gain_k=lowfreq_gain_k,
        beta_z=beta_z,
        beta_fb=beta_fb, beta_nb=beta_nb,
        hf_tilt_n=hf_tilt_n, hf_f0=hf_f0,
        lf_shelf_k=lf_shelf_k, lf_f0=lf_f0, lf_n=lf_n,
        phi_units=phi_units,
        corr_len_scale=corr_len_scale,
        mon=mon, K_cal=K_cal,
        mf_boost_k=mf_boost_k, mf_f0=mf_f0, mf_n=mf_n,
        geom_norm=geom_norm,
        span_model=span_model,
        span_hybrid_kyL_thresh = span_hybrid_kyL_thresh,
        span_hybrid_blend_width = span_hybrid_blend_width,
    )
    if mon and hasattr(mon, "header"):
        mon.header("Amiet TE kernel (hybrid span + 4πR² + neutral shapes)")
        mon.info("[units] Spp output is Pa^2/Hz; SPL uses 20µPa reference.")
    _mon_kv(mon, "Ue", Ue); _mon_kv(mon, "Uc", Uc); _mon_kv(mon, "a(c0)", c0)
    _mon_kv(mon, "theta_deg", theta_deg); _mon_kv(mon, "phi_deg", phi_deg)
    _mon_kv(mon, "delta99", delta99); _mon_kv(mon, "L_span", L); _mon_kv(mon, "R", R)
    _mon_kv(mon, "te_model", te_model)
    _mon_kv(mon, "span_model", span_model)
    return Spp

# ---------------- δ99 获取/兜底 ----------------
_NUM = r'[+\-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[Ee][+\-]?\d+)?'
_LINE  = re.compile(r'^\s*' + _NUM + r'(?:\s+' + _NUM + r')+\s*$')

def _require_delta99(flow, bl=None, mon=None) -> float:
    # 1) 显式字段
    for holder in (bl, flow):
        if holder is None: continue
        for name in ("delta99", "delta_99", "delta99m", "delta_99m", "delta"):
            if hasattr(holder, name) and getattr(holder, name) is not None:
                try:
                    val = float(getattr(holder, name))
                    if val > 0:
                        _mon_kv(mon, "δ99(source)", name)
                        return val
                except Exception:
                    pass
    # 2) θ 兜底（δ99≈9·θ），可用 H=δ*/θ 微调
    theta = None
    for holder in (bl, flow):
        if holder is None: continue
        for nm in ("theta", "theta_m", "momentumThickness"):
            if hasattr(holder, nm) and getattr(holder, nm) is not None:
                try:
                    theta = float(getattr(holder, nm)); break
                except Exception:
                    theta = None
        if theta is not None: break
    if theta is not None and theta > 0:
        delta99_est = 9.0 * theta
        H = None
        for holder in (bl, flow):
            if holder is None: continue
            for nm in ("delta_star", "deltaStar", "displacementThickness"):
                if hasattr(holder, nm) and getattr(holder, nm) is not None:
                    try:
                        delta_star = float(getattr(holder, nm))
                        if delta_star > 0: H = delta_star / theta
                    except Exception: pass
        if H is not None and H > 0:
            delta99_est *= (H / 1.35)
        _mon_kv(mon, "δ99(estimated)", delta99_est)
        return max(delta99_est, 1e-9)
    raise ValueError("缺少 δ99：请提供 delta99 或 θ（将用 δ99≈9·θ 兜底）。")

