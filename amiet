def _read_probes_meta(path: str) -> List[Tuple[float,float,float,str]]:
    out = []
    with open(path, "r", encoding="utf-8") as fh:
        next(fh, None)
        for raw in fh:
            toks = [t.strip() for t in raw.strip().split(",")]
            if len(toks) < 5: continue
            _, xs, ys, zs, lab = toks[:5]
            try:
                out.append((float(xs), float(ys), float(zs), lab))
            except: pass
    return out

def _read_openfoam_probes_table(path: str) -> Tuple[np.ndarray, np.ndarray]:
    times = []; rows = []
    with open(path, "r", encoding="utf-8") as fh:
        lines = [ln.rstrip("\n") for ln in fh]
    if not lines: raise ValueError(f"empty probes file: {path}")
    header = lines[0]
    for ln in lines[1:]:
        ln = ln.strip()
        if not ln: continue
        if not _LINE.match(ln): continue
        vals = [float(v) for v in ln.split()]
        times.append(vals[0]); rows.append(vals[1:])
    if not rows: raise ValueError(f"no data rows in {path}")
    return np.asarray(times, float), np.asarray(rows, float)

def _last_snapshot(values: np.ndarray) -> np.ndarray:
    return values[-1, :].copy()

def _vector3_from_flat(flat: np.ndarray) -> np.ndarray:
    if flat.size % 3 != 0:
        raise ValueError("vector field columns not multiple of 3")
    return flat.reshape((-1, 3))

def rebuild_line_normal_from_probes(case_dir: str, amiet_dir: str, *, xc: float, mon: Monitor) -> List[str]:
    pp_dir = os.path.join(case_dir, "postProcessing", "probesDict_TE", "0")
    meta_csv = os.path.join(case_dir, "amiet_inputs", "probes_TE_meta.csv")
    if not os.path.isfile(meta_csv):
        cand = glob.glob(os.path.join(case_dir, "**", "probes_TE_meta.csv"), recursive=True)
        if cand:
            meta_csv = cand[0]
    if not os.path.isdir(pp_dir) or not os.path.isfile(meta_csv):
        mon.warn(f"缺 probes 源：{pp_dir} 或 {meta_csv}")
        return []
    mon.header("Rebuild line-normal from probes")
    mon.info(f"读取 meta: {meta_csv}")
    meta = _read_probes_meta(meta_csv)
    if not meta: raise ValueError("probes_TE_meta.csv 为空或异常")

    fld_files = {}
    need = ["U","p","rho","k","omega","nut","alphat","T"]
    for nm in need:
        f = os.path.join(pp_dir, nm)
        if os.path.isfile(f): fld_files[nm]=f; mon.info(f"发现 probes 字段：{nm} -> {f}")
    if "U" not in fld_files:
        raise FileNotFoundError("probes 缺 U 字段，无法重建法向剖面")

    times, Utab = _read_openfoam_probes_table(fld_files["U"])
    U_last = _vector3_from_flat(_last_snapshot(Utab))
    npts = U_last.shape[0]
    def grab_scalar(name):
        if name not in fld_files: return None
        t, arr = _read_openfoam_probes_table(fld_files[name])
        return _last_snapshot(arr)
    p_last   = grab_scalar("p")
    rho_last = grab_scalar("rho")
    k_last   = grab_scalar("k")
    om_last  = grab_scalar("omega")
    nut_last = grab_scalar("nut")
    at_last  = grab_scalar("alphat")

    ys_by_label: Dict[str, List[float]] = {}
    U_by_label:  Dict[str, List[float]] = {}
    scalars_by_label: Dict[str, Dict[str, List[float]]] = {}
    used_idx = 0
    for i,(x,y,z,lab) in enumerate(meta):
        if i >= npts: break
        ys_by_label.setdefault(lab, []).append(y)
        U_by_label.setdefault(lab, []).append(np.linalg.norm(U_last[i,:]))
        if p_last is not None:   scalars_by_label.setdefault(lab, {}).setdefault("p", []).append(p_last[i])
        if rho_last is not None: scalars_by_label.setdefault(lab, {}).setdefault("rho", []).append(rho_last[i])
        if k_last is not None:   scalars_by_label.setdefault(lab, {}).setdefault("k", []).append(k_last[i])
        if om_last is not None:  scalars_by_label.setdefault(lab, {}).setdefault("omega", []).append(om_last[i])
        if nut_last is not None: scalars_by_label.setdefault(lab, {}).setdefault("nut", []).append(nut_last[i])
        if at_last is not None:  scalars_by_label.setdefault(lab, {}).setdefault("alphat", []).append(at_last[i])
        used_idx += 1
    mon.info(f"按 label 聚合完成，使用点数 {used_idx}/{npts}")

    os.makedirs(amiet_dir, exist_ok=True)
    created = []
    def write_profile(tag, yv, Uv, scalars):
        fn = os.path.join(amiet_dir, f"line_normal_xc{xc:.2f}_{tag}.csv".replace("0.","0p").replace("1.","1p"))
        order = np.argsort(yv)
        cols = ["y","U"]
        table = [ [yv[j], Uv[j]] for j in order ]
        for k in ["p","rho","k","omega","nut","alphat"]:
            if (scalars is not None) and (k in scalars):
                cols.append(k)
                for rj, j in enumerate(order):
                    table[rj].append(scalars[k][j])
        with open(fn, "w", newline="", encoding="utf-8") as fh:
            w = csv.writer(fh); w.writerow(cols); w.writerows(table)
        created.append(fn); mon.info(f"写出: {fn}")

    SS = [k for k in ys_by_label if "SS" in k.upper()]
    PS = [k for k in ys_by_label if "PS" in k.upper()]
    if SS:
        lab = SS[0]; write_profile("SS", ys_by_label[lab], U_by_label[lab], scalars_by_label.get(lab,{}))
    if PS:
        lab = PS[0]; write_profile("PS", ys_by_label[lab], U_by_label[lab], scalars_by_label.get(lab,{}))
    if SS and PS:
        y_sum = np.array(ys_by_label[SS[0]] + [-v for v in ys_by_label[PS[0]]], float)
        U_sum = np.array(U_by_label[SS[0]] + U_by_label[PS[0]], float)
        scal_sum: Dict[str,List[float]] = {}
        for key in ["p","rho","k","omega","nut","alphat"]:
            if key in scalars_by_label.get(SS[0],{}) or key in scalars_by_label.get(PS[0],{}):
                scal_sum[key] = scalars_by_label.get(SS[0],{}).get(key, []) + scalars_by_label.get(PS[0],{}).get(key, [])
        write_profile("SUM", np.abs(y_sum), U_sum, scal_sum)
    return created

