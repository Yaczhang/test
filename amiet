def _read_raw_xy_columns(path: str) -> Dict[str, np.ndarray]:
    with open(path, "r", encoding="utf-8", errors="ignore") as fh:
        lines = [ln.strip() for ln in fh if ln.strip()]
    data = []
    for ln in lines:
        toks = ln.replace(",", " ").split()
        try:
            row = [float(v) for v in toks]; data.append(row)
        except:
            continue
    arr = np.array(data, float)
    out: Dict[str,np.ndarray] = {}
    if arr.ndim==2 and arr.shape[1]>=4:
        out["x"] = arr[:,0]; out["y"]=arr[:,1]; out["z"]=arr[:,2]
        out["cols"] = arr[:,3:]
    return out

def rebuild_cf_and_bl_from_surface(case_dir: str, amiet_dir: str, mon: Monitor) -> List[str]:
    created = []
    surf_root = os.path.join(case_dir, "postProcessing", "surfaces_airfoil")
    if not os.path.isdir(surf_root):
        mon.warn(f"缺少 surfaces_airfoil 目录：{surf_root}")
        return created
    cand = [d for d in glob.glob(os.path.join(surf_root, "*")) if os.path.isdir(d)]
    if not cand:
        mon.warn("surfaces_airfoil 下没有时间目录"); return created
    latest = sorted(cand, key=lambda p: float(os.path.basename(p).replace("_","") or "0"))[-1]
    mon.info(f"surfaces latest dir = {latest}")

    f_tau = os.path.join(latest, "wallShearStress_airfoil_all.raw")
    f_U   = os.path.join(latest, "U_airfoil_all.raw")
    f_rho = os.path.join(latest, "rho_airfoil_all.raw")

    if os.path.isfile(f_tau) and os.path.isfile(f_U):
        mon.info(f"读取 raw: {f_tau}")
        d_tau = _read_raw_xy_columns(f_tau)
        mon.info(f"读取 raw: {f_U}")
        d_U   = _read_raw_xy_columns(f_U)
        if "cols" in d_tau and d_tau["cols"].shape[1] >= 3:
            tau_mag = np.linalg.norm(d_tau["cols"][:, :3], axis=1)
        else:
            tau_mag = d_tau.get("cols", np.zeros((0,1)))[:,0] if "cols" in d_tau else np.array([])
        if "cols" in d_U and d_U["cols"].shape[1] >= 3:
            U_mag = np.linalg.norm(d_U["cols"][:, :3], axis=1)
        else:
            U_mag = d_U.get("cols", np.zeros((0,1)))[:,0] if "cols" in d_U else np.array([])
        if tau_mag.size and U_mag.size and d_U["x"].size==U_mag.size:
            rho_use = None
            f_fs = os.path.join(amiet_dir, "freestream.csv")
            if os.path.isfile(f_rho):
                d_rho = _read_raw_xy_columns(f_rho)
                rho_local = d_rho["cols"][:,0] if "cols" in d_rho else np.full_like(U_mag, np.nan)
                rho_use = np.nanmean(rho_local) if np.any(np.isfinite(rho_local)) else None
            if rho_use is None and os.path.isfile(f_fs):
                fs = _read_keyval_csv(f_fs)
                rho_use = float(_prefer(fs.get("rho"), fs.get("rhoinf")))
            if rho_use is None:
                mon.warn("ρ 未找到，Cf 无法计算")
            else:
                x = d_U["x"]
                order = np.argsort(x)
                x_s = x[order]; Cf = tau_mag[order] / np.maximum(0.5*rho_use*(U_mag[order]**2), 1e-16)
                out_cf = os.path.join(amiet_dir, "Cf_surface_xc.csv")
                with open(out_cf, "w", newline="", encoding="utf-8") as fh:
                    w = csv.writer(fh); w.writerow(["x","Cf"]); w.writerows(zip(x_s, Cf))
                created.append(out_cf); mon.info(f"写出: {out_cf}")
        else:
            mon.warn("raw 列数或大小不匹配，跳过 Cf 估算")
    else:
        mon.warn("缺少 wallShearStress 或 U raw，跳过 Cf")

    f_bl = os.path.join(amiet_dir, "bl_params_TE.csv")
    if not os.path.isfile(f_bl):
        prof = None
        for p in glob.glob(os.path.join(amiet_dir, "line_normal_xc*_[S|P][S].csv")) + \
                 glob.glob(os.path.join(amiet_dir, "line_normal_xc*_SUM.csv")):
            prof = p; break
        if prof:
            profdat = _read_profile_csv(prof)
            f_fs = os.path.join(amiet_dir, "freestream.csv")
            if os.path.isfile(f_fs):
                fs = _read_keyval_csv(f_fs)
                rho = float(_prefer(fs.get("rho"), fs.get("rhoinf")))
                mu  = float(_prefer(fs.get("mu"),  fs.get("muinf")))
                bl = bl_params_from_profile(profdat["y"], profdat["u"], rho=rho, mu=mu)
                with open(f_bl, "w", newline="", encoding="utf-8") as fh:
                    w = csv.writer(fh)
                    w.writerow(["Ue","Cf","theta","delta_star","delta","utau","Uc","APG_pi"])
                    w.writerow([bl.Ue, bl.Cf, bl.theta, bl.delta_star, bl.delta, bl.utau or "", bl.Uc or "", bl.APG_pi or ""])
                created.append(f_bl); mon.info(f"写出: {f_bl}")
        else:
            mon.warn("无可用的 line_normal_xc，跳过 BL 参数估算")
    return created

